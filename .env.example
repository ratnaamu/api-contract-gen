# Copy this file to .env and fill in your own values to enable `--llm-refine`
# (python main.py build/watch/demo --llm-refine, or python main.py llm-check).
# ── AIDH (Unisys hosted LLMs) ─────────────────────────────────
AIDH_BASE_URL=https://us-llm-1.na.uis.unisys.com
AIDH_DOMAIN_ID=your-domain-id
AIDH_MODEL=llama3.1:8b
